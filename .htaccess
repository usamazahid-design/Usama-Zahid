# ==============================================================================
# usamazahid.design  -  .htaccess for Hostinger (Apache/LiteSpeed)
# Upload this file into public_html (the folder that contains index.html).
# If Hostinger already has a .htaccess there, MERGE the two files instead
# of replacing (keep both sets of rules).
# ==============================================================================

Options -Indexes
ErrorDocument 404 /404.html

# ------------------------------------------------------------------------------
# 1) HTTPS + www -> non-www redirect (canonical is https://usamazahid.design)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host redirect: force apex domain for any non-canonical host
  RewriteCond %{HTTP_HOST} !^usamazahid\.design$ [NC]
  RewriteRule ^ https://usamazahid.design%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------------------------
  # 301 redirects for retired / reorganized URLs
  # ----------------------------------------------------------------------------
  # /work -> /portfolio
  RewriteRule ^work/?$ /portfolio/ [L,R=301]
  RewriteRule ^work/.*$ /portfolio/ [L,R=301]

  # Legacy service routes
  RewriteRule ^services/branding/?$ /services/identity/ [L,R=301]
  RewriteRule ^services/development/?$ /services/engineering/ [L,R=301]
  RewriteRule ^services/brand-to-url/?$ /brand-to-url/ [L,R=301]
  RewriteRule ^ai-product-design/?$ /brand-to-url/ [L,R=301]

  # Legacy privacy
  RewriteRule ^privacy/?$ /privacy-policy/ [L,R=301]
  RewriteRule ^design-system/?$ /blog/product/saas-design-operating-system/ [L,R=301]

  # Old journal/blog routes
  RewriteRule ^journals/.*$ /blog/ [L,R=301]
  RewriteRule ^journal/.*$ /blog/ [L,R=301]
  # Legacy flat blog URLs -> service blog URLs
  RewriteRule ^blog/brand-to-url-operating-system/?$ /blog/strategy/brand-to-url-operating-system/ [L,R=301]
  RewriteRule ^blog/why-i-sign-every-receipt-in-28-days/?$ /blog/strategy/why-i-sign-every-receipt-in-28-days/ [L,R=301]
  RewriteRule ^blog/case-for-single-operator-studios/?$ /blog/strategy/case-for-single-operator-studios/ [L,R=301]
  RewriteRule ^blog/nextjs-framer-motion-gsap-triangulation/?$ /blog/engineering/nextjs-framer-motion-gsap-triangulation/ [L,R=301]
  RewriteRule ^blog/48-hour-build-protocol/?$ /blog/engineering/48-hour-build-protocol/ [L,R=301]
  RewriteRule ^blog/what-physics-taught-me-about-design-constraints/?$ /blog/strategy/what-physics-taught-me-about-design-constraints/ [L,R=301]
  RewriteRule ^blog/myths-truths-building-brands-2026-bad-ux-kills-conversion/?$ /blog/identity/myths-truths-building-brands-2026-bad-ux-kills-conversion/ [L,R=301]
  RewriteRule ^blog/why-i-teach-design-as-a-ladder-iop-digital/?$ /blog/strategy/why-i-teach-design-as-a-ladder-iop-digital/ [L,R=301]
  RewriteRule ^blog/saas-design-operating-system/?$ /blog/product/saas-design-operating-system/ [L,R=301]
  RewriteRule ^blog/how-to-design-saas-website-that-converts/?$ /blog/website/how-to-design-saas-website-that-converts/ [L,R=301]
  RewriteRule ^blog/ai-ux-design-patterns/?$ /blog/product/ai-ux-design-patterns/ [L,R=301]
  RewriteRule ^blog/freelance-designer-vs-agency-for-saas/?$ /blog/strategy/freelance-designer-vs-agency-for-saas/ [L,R=301]
  RewriteRule ^blog/how-much-does-saas-website-design-cost/?$ /blog/marketing/how-much-does-saas-website-design-cost/ [L,R=301]
  RewriteRule ^blog/ai-product-design-build-saas-products-users-trust/?$ /blog/product/ai-product-design-build-saas-products-users-trust/ [L,R=301]
  RewriteRule ^blog/ai-features-that-dont-feel-gimmicky/?$ /blog/product/ai-features-that-dont-feel-gimmicky/ [L,R=301]
  RewriteRule ^blog/ai-onboarding-design-why-youre-losing-users/?$ /blog/product/ai-onboarding-design-why-youre-losing-users/ [L,R=301]
  RewriteRule ^blog/designing-for-uncertainty-ai-ux-patterns/?$ /blog/product/designing-for-uncertainty-ai-ux-patterns/ [L,R=301]
  RewriteRule ^blog/the-trust-gap-in-ai-products/?$ /blog/product/the-trust-gap-in-ai-products/ [L,R=301]
  RewriteRule ^blog/brand-identity-for-tech-startups-a-revenue-problem/?$ /blog/identity/brand-identity-for-tech-startups-a-revenue-problem/ [L,R=301]
  RewriteRule ^blog/build-a-credible-brand-identity-on-a-pre-seed-budget/?$ /blog/identity/build-a-credible-brand-identity-on-a-pre-seed-budget/ [L,R=301]
  RewriteRule ^blog/generic-saas-design-isnt-safe-its-invisible/?$ /blog/identity/generic-saas-design-isnt-safe-its-invisible/ [L,R=301]
  RewriteRule ^blog/the-visual-consistency-checklist-saas-founders/?$ /blog/identity/the-visual-consistency-checklist-saas-founders/ [L,R=301]
  RewriteRule ^blog/what-is-brand-gravity-why-weak-brand-identity-raises-cpa/?$ /blog/identity/what-is-brand-gravity-why-weak-brand-identity-raises-cpa/ [L,R=301]
  RewriteRule ^blog/saas-design-best-practices-a-founders-diagnostic/?$ /blog/product/saas-design-best-practices-a-founders-diagnostic/ [L,R=301]
  RewriteRule ^blog/audit-your-saas-product-for-cognitive-load/?$ /blog/product/audit-your-saas-product-for-cognitive-load/ [L,R=301]
  RewriteRule ^blog/decision-architecture-how-saas-pages-convert-enterprise-buyers/?$ /blog/product/decision-architecture-how-saas-pages-convert-enterprise-buyers/ [L,R=301]
  RewriteRule ^blog/saas-product-designer-vs-ui-designer/?$ /blog/product/saas-product-designer-vs-ui-designer/ [L,R=301]
  RewriteRule ^blog/how-your-saas-website-affects-fundraising/?$ /blog/marketing/how-your-saas-website-affects-fundraising/ [L,R=301]
  RewriteRule ^blog/how-to-design-a-saas-website-that-wins-enterprise-buyers-and-seed-investors/?$ /blog/marketing/how-to-design-a-saas-website-that-wins-enterprise-buyers-and-seed-investors/ [L,R=301]
  RewriteRule ^blog/invest-in-your-saas-website-before-paid-ads/?$ /blog/marketing/invest-in-your-saas-website-before-paid-ads/ [L,R=301]
  RewriteRule ^blog/the-credibility-gap-why-a-weak-visual-system-costs-you-more/?$ /blog/identity/the-credibility-gap-why-a-weak-visual-system-costs-you-more/ [L,R=301]
  RewriteRule ^blog/what-investors-see-on-your-saas-website/?$ /blog/marketing/what-investors-see-on-your-saas-website/ [L,R=301]
  RewriteRule ^blog/why-your-saas-hero-section-loses-visitors-in-3-seconds/?$ /blog/website/why-your-saas-hero-section-loses-visitors-in-3-seconds/ [L,R=301]
  RewriteRule ^blog/10-saas-landing-pages-torn-apart/?$ /blog/website/10-saas-landing-pages-torn-apart/ [L,R=301]
  RewriteRule ^blog/cognitive-load-is-killing-your-saas-conversions/?$ /blog/product/cognitive-load-is-killing-your-saas-conversions/ [L,R=301]
  RewriteRule ^courses/?$ /services/ [L,R=301]
  RewriteRule ^process/?$ /services/ [L,R=301]

  # Removed case studies -> portfolio index
  RewriteRule ^portfolio/neuraldesk-copilot/?$ /portfolio/ [L,R=301]
  RewriteRule ^portfolio/ledgerflow-ai/?$ /portfolio/ [L,R=301]
  RewriteRule ^portfolio/opsorbit-assistant/?$ /portfolio/ [L,R=301]
  RewriteRule ^portfolio/cadence-habit-app/?$ /portfolio/ [L,R=301]

  # Hostinger often cannot serve folders named "_next". Build renames to /nxt/.
  # Keep this fallback if any cached HTML still requests /_next/.
  RewriteRule ^_next/(.*)$ /nxt/$1 [L]
</IfModule>

# ------------------------------------------------------------------------------
# 2) Security headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Strict Transport Security (enable only once you confirm HTTPS works on every page)
  Header always set Strict-Transport-Security "max-age=31536000"

  # Content-Security-Policy
  # - 'unsafe-inline' is required for Next.js static export (inline scripts/styles)
  # - If a feature misbehaves after upload, check browser console for CSP warnings
  #   and add the reported domain to the matching directive below.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://app.cal.com; style-src 'self' 'unsafe-inline' https://app.cal.com; img-src 'self' data: blob: https://images.unsplash.com; font-src 'self' data:; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://cal.com https://app.cal.com; frame-src https://cal.com https://app.cal.com https://www.figma.com https://www.loom.com; worker-src 'self' blob:; base-uri 'self'; form-action 'self' https://cal.com; object-src 'none'; frame-ancestors 'self'"
</IfModule>

# ------------------------------------------------------------------------------
# 3) Cache control
#    - Hashed JS/CSS from /nxt/static/ -> cache for 1 year (immutable)
#    - Images -> 30 days
#    - HTML -> never cached (so new deploys appear immediately)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|png|jpe?g|gif|svg|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 4) Compression (if mod_deflate is available)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
