# PostHog Configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Brand Kit Generator — AI Proxy Configuration (Cloudflare Worker or Serverless Function)
# The browser only communicates with your secure proxy; API keys are never exposed in client code.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_or_gemini_api_key_here
AI_MODEL=gpt-4o-mini

# Optional frontend proxy URL (defaults to /api/brand-ai or falls back to built-in rules if empty)
NEXT_PUBLIC_BRAND_AI_ENDPOINT=https://your-worker.your-subdomain.workers.dev

